# Frontend Environment Variables
# For LOCAL development: copy this to .env.local (already ignored by git)
# For VERCEL: add these in the Vercel dashboard under Project > Settings > Environment Variables

# URL of your deployed backend (Render/Railway)
# In production: set this to https://your-backend.onrender.com
# Locally: leave as default (http://localhost:8000)
NEXT_PUBLIC_API_URL=http://localhost:8000
