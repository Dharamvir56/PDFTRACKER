# PDF Tracker Backend - Environment Variables
# Copy this file to .env and fill in real values for production

# ── Database ───────────────────────────────────────────────────────────────
# Local (default): sqlite:///./tracker.db
# Production (PostgreSQL from Supabase/Neon):
DATABASE_URL=sqlite:///./tracker.db

# ── Security ───────────────────────────────────────────────────────────────
# CHANGE THIS to a long random string in production!
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-change-in-production

# ── CORS ───────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# In production, set to your Vercel frontend URL:
# ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,http://localhost:8000

# ── S3 Storage (optional, required in production) ──────────────────────────
# Leave empty to use local file storage (development only)
# In production, set these to use AWS S3 / Cloudflare R2 / Supabase Storage
# S3_BUCKET=your-bucket-name
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_REGION=us-east-1
